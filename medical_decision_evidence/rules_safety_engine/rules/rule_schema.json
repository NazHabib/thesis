{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rules Safety Engine Ruleset Schema",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "rule_version",
          "name",
          "group",
          "priority",
          "condition",
          "missing_policy",
          "severity",
          "action_type",
          "action_code"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "missing_policy": {
            "type": "string",
            "enum": ["na_false", "na_true", "na_error"]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "moderate", "high", "critical"]
          },
          "action_type": {
            "type": "string",
            "enum": ["recommend", "forbid", "escalate", "inform"]
          },
          "action_code": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "contraindications_unknown": {
            "type": "boolean",
            "default": false
          },
          "explanation_template": {
            "type": "string",
            "default": ""
          },
          "citations": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "conflict_group": {
            "type": ["string", "null"]
          },
          "conflict_policy": {
            "type": ["string", "null"],
            "enum": [
              "keep_strongest",
              "keep_all",
              "suppress_weaker_same_group",
              "suppress_recommend_if_escalate",
              "mutually_exclusive",
              null
            ]
          },
          "suppresses": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "provenance": {
            "type": "object",
            "default": {}
          },
          "created_by": {
            "type": "string",
            "default": "unknown"
          },
          "created_at": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
